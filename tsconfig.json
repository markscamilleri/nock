{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "dist/types",
    "rootDir": "lib",
    "moduleResolution": "node16",
    "typeRoots": ["./types", "./node_modules/@types"],
  },
  "include": ["lib/**/*"],
  "exclude": ["node_modules", "dist", "tests", "examples"]
}
